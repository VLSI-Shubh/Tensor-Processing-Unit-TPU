digraph "tpu_core" {
label="tpu_core";
rankdir="LR";
remincross=true;
n1 [ shape=octagon, label="a_in", color="black", fontcolor="black" ];
n2 [ shape=diamond, label="a_row", color="black", fontcolor="black" ];
n3 [ shape=diamond, label="b_col", color="black", fontcolor="black" ];
n4 [ shape=octagon, label="b_in", color="black", fontcolor="black" ];
n5 [ shape=octagon, label="busy", color="black", fontcolor="black" ];
n6 [ shape=diamond, label="c_flat", color="black", fontcolor="black" ];
n7 [ shape=octagon, label="c_out", color="black", fontcolor="black" ];
n8 [ shape=octagon, label="c_valid", color="black", fontcolor="black" ];
n9 [ shape=octagon, label="clk", color="black", fontcolor="black" ];
n10 [ shape=diamond, label="clr", color="black", fontcolor="black" ];
n11 [ shape=octagon, label="done", color="black", fontcolor="black" ];
n12 [ shape=diamond, label="out_en", color="black", fontcolor="black" ];
n13 [ shape=diamond, label="out_idx", color="black", fontcolor="black" ];
n14 [ shape=diamond, label="rd_en", color="black", fontcolor="black" ];
n15 [ shape=diamond, label="rd_t", color="black", fontcolor="black" ];
n16 [ shape=octagon, label="relu_mode", color="black", fontcolor="black" ];
n17 [ shape=octagon, label="rst_n", color="black", fontcolor="black" ];
n18 [ shape=octagon, label="start", color="black", fontcolor="black" ];
n19 [ shape=octagon, label="transpose_mode", color="black", fontcolor="black" ];
n20 [ shape=octagon, label="valid_in", color="black", fontcolor="black" ];
n21 [ shape=diamond, label="wr_en", color="black", fontcolor="black" ];
n22 [ shape=diamond, label="wr_idx", color="black", fontcolor="black" ];
c23 [ shape=record, label="{{<p9> clk|<p17> rst_n|<p18> start|<p20> valid_in}|ctrl\ncontrol_unit|{<p5> busy|<p10> clr|<p11> done|<p12> out_en|<p13> out_idx|<p14> rd_en|<p15> rd_t|<p21> wr_en|<p22> wr_idx}}",  ];
c24 [ shape=record, label="{{<p1> a_in|<p4> b_in|<p9> clk|<p14> rd_en|<p15> rd_t|<p21> wr_en|<p22> wr_idx}|input_feeder\nfeeder|{<p2> a_row|<p3> b_col}}",  ];
c29 [ shape=record, label="{{<p6> c_flat|<p9> clk|<p25> en|<p16> relu_mode|<p17> rst_n|<p26> sel|<p19> transpose_mode}|output_collector\ncollector|{<p27> result_out|<p28> result_valid}}",  ];
c30 [ shape=record, label="{{<p2> a_row|<p3> b_col|<p9> clk|<p10> clr|<p17> rst_n}|systolic\nsystolic_array|{<p6> c_flat}}",  ];
n1:e -> c24:p1:w [color="black", fontcolor="black", style="setlinewidth(3)", label=""];
c23:p10:e -> n10:w [color="black", fontcolor="black", label=""];
n10:e -> c30:p10:w [color="black", fontcolor="black", label=""];
